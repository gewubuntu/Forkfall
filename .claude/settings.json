{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/pr-opened.sh\"",
            "statusMessage": "Queueing the PR review"
          }
        ]
      }
    ]
  }
}
