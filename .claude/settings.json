{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^mcp__.*github.*__create_pull_request$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/pr-opened.sh\"",
            "statusMessage": "Reminding Claude to review the new PR"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "claudeMdExcludes": ["**/contracts/lib/**/CLAUDE.md"],
  "permissions": {
    "deny": ["Skill(add-changeset)", "Skill(solidity-style)", "Skill(library-api-design)", "Skill(testing)"],
    "ask": ["mcp__*__merge_pull_request", "mcp__*__enable_pr_auto_merge"]
  },
  "enabledPlugins": {
    "engineering@synced": false
  }
}
