# ── Forkfall: TESTNET ONLY ─────────────────────────────────────────
# Copy to .env (git-ignored). The hub chain is Base Sepolia (84532).
# Never put a mainnet key or RPC here. Contracts and scripts refuse non-testnet chain ids.

# ── Contracts (pnpm deploy:base-sepolia / check:base-sepolia) ─────
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Etherscan API v2 key from etherscan.io: verifies contracts on sepolia.basescan.org
ETHERSCAN_API_KEY=
# Foundry keystore account holding the deployer key (create with: cast wallet import forkfall-deployer --interactive)
DEPLOYER_ACCOUNT=forkfall-deployer
# Address of the referee key (= HOUSE_PRIVATE_KEY below). Gets REFEREE_ROLE; co-signs ranked results.
REFEREE_ADDRESS=
# Receives pack sale proceeds (defaults to the deployer)
TREASURY_ADDRESS=
# Where card metadata is served: https://<referee server>/metadata, or ipfs://<cid> of a pinned `pnpm art:export` folder
METADATA_BASE=
# Optional overrides of <METADATA_BASE>/cards/{id}.json and <METADATA_BASE>/contract.json
CARD_URI=
CONTRACT_URI=
PACK_PRICE_WEI=100000000000000

# Optional second chain (Brokers & Degens side)
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc

# ── Referee server (pnpm server) ──────────────────────────────────
CHAIN_ID=84532
# Defaults to https://sepolia.base.org; a dedicated RPC (Alchemy, QuickNode, Coinbase CDP…) is recommended
RPC_URL=
# Referee / house-bot key. Its address must be REFEREE_ADDRESS above.
HOUSE_PRIVATE_KEY=
PORT=8787
TURN_SECONDS=45
BANK_SECONDS=60
# Referee auto-settles results the loser never signs (needs testnet ETH on HOUSE_PRIVATE_KEY). 0 = off
AUTO_SETTLE=1
# Seconds the loser has to co-sign before the referee settles (timeouts and concedes settle at once)
RESULT_GRACE_SECONDS=600
# One-click testnet human verification by the referee (0 = off; real providers plug in later)
HUMAN_TESTNET_VERIFY=1
# Deployer/admin key for `pnpm rewards:publish` (REWARDS_ADMIN_ROLE, tFALL owner)
REWARDS_ADMIN_PRIVATE_KEY=
# Public origin of this server, for absolute links in card metadata (defaults to the request host)
PUBLIC_URL=
# Where published Agent League weeks are read from (written by `pnpm league:publish`)
LEAGUE_DIR=
# Player profiles (tutorial done, equipped cosmetics); default apps/server/data/profiles/<CHAIN_ID>.json
PROFILES_FILE=
# Daily quests: progress + payouts file (default apps/server/data/quests/<CHAIN_ID>.json); free pack period in days
# (7 = weekly, 14 = every two weeks), quests needed per period (default 10 per week), and the free pack's kind (0 = Set 1)
QUESTS_FILE=
QUEST_PACK_DAYS=7
QUEST_PACK_GOAL=
QUEST_PACK_KIND=0

# ── Pack randomness (deploy) ──────────────────────────────────────
# Chainlink VRF v2.5 (required before mainnet). Coordinator + key hash: Chainlink's "VRF supported networks" page
# for your chain. Create and fund a subscription at vrf.chain.link, then add PackSale as a consumer after deploying.
# Leave empty on a testnet to use the commit/blockhash source; Anvil deploys a local mock automatically.
VRF_COORDINATOR=
VRF_KEY_HASH=
VRF_SUBSCRIPTION_ID=
VRF_CONFIRMATIONS=3
VRF_NATIVE_PAYMENT=false

# ── Agents (pnpm bot / pnpm mcp) ──────────────────────────────────
FORKFALL_SERVER=http://localhost:8787
FORKFALL_PRIVATE_KEY=
