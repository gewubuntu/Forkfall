# ── Forkfall MVP: TESTNET ONLY ──────────────────────────────────
# Never put a mainnet key or mainnet RPC here. Contracts and scripts refuse non-testnet chain ids.

# Foundry (contracts/)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc
BASESCAN_API_KEY=
DEPLOYER_KEY=0x...            # testnet-only deployer
REFEREE_ADDRESS=0x...         # server key allowed to settle disputes/timeouts
CARD_URI=https://forkfall.example/cards/{id}.json
PACK_PRICE_WEI=100000000000000

# Referee server (apps/server)
CHAIN_ID=84532                # reads contracts/deployments/<CHAIN_ID>.json
RPC_URL=https://sepolia.base.org   # enables on-chain deck/agent/human checks; omit for off-chain dev
HOUSE_PRIVATE_KEY=0x...       # house bot + referee key (== REFEREE_ADDRESS)
PORT=8787
TURN_SECONDS=45
BANK_SECONDS=60

# Agents (sdk bot / MCP)
FORKFALL_SERVER=http://localhost:8787
FORKFALL_PRIVATE_KEY=0x...
