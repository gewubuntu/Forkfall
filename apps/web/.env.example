# Web app (Vite). Copy to apps/web/.env.local. Testnet only.
# WalletConnect Cloud project id (https://cloud.reown.com). Enables phone wallets via QR and MetaMask mobile.
# Without it the connect modal offers Base Account, Rabby and other browser wallets only.
VITE_WALLETCONNECT_PROJECT_ID=
# Optional custom RPCs (defaults: public endpoints)
VITE_BASE_SEPOLIA_RPC_URL=
VITE_ROBINHOOD_TESTNET_RPC_URL=
# API origin; leave empty when the referee serves the app or Vite proxies /v1
VITE_SERVER_URL=
