# Forkfall server settings. Copy to deploy/.env on the server (chmod 600) and fill in.
# Never commit deploy/.env: it holds the referee key.

# ── Web address ───────────────────────────────────────────────────
# Point an A (and AAAA) DNS record for this name at the server first; Caddy then gets the HTTPS certificate itself.
DOMAIN=play.example.com
# Let's Encrypt account e-mail (expiry notices)
ACME_EMAIL=you@example.com

# ── Chain ─────────────────────────────────────────────────────────
# Base Sepolia. The contract addresses come from contracts/deployments/84532.json in the repo
# (written by `pnpm deploy:base-sepolia`, then committed).
CHAIN_ID=84532
# A dedicated RPC is strongly recommended over the public https://sepolia.base.org (rate limits)
RPC_URL=

# ── Referee key ───────────────────────────────────────────────────
# Holds REFEREE_ROLE: co-signs results, runs the house bot, pays quest rewards. Testnet only.
# Fund it with a little Base Sepolia ETH and watch the balance.
HOUSE_PRIVATE_KEY=

# ── Web app (baked in at build time; public values) ─────────────────
# RPC the players' browsers use for reads (can be the same provider as RPC_URL, with a browser-safe key)
VITE_BASE_SEPOLIA_RPC_URL=
# WalletConnect / Reown project id (mobile wallets)
VITE_WALLETCONNECT_PROJECT_ID=

# ── Optional ──────────────────────────────────────────────────────
# Turn timer and the loser's signing grace period (seconds)
# TURN_SECONDS=45
# BANK_SECONDS=60
# RESULT_GRACE_SECONDS=600
# Referee settles unsigned results itself (needs ETH); 0 = off
# AUTO_SETTLE=1
# Free pack every 7 or 14 days
# QUEST_PACK_DAYS=7
# Before a contract deployment exists: UI only, nothing settles
# OFFCHAIN=1
