{
  "name": "forkfall",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "sim": "tsx packages/engine/scripts/simulate.ts",
    "gen:cards": "tsx packages/engine/scripts/gen-solidity.ts",
    "server": "tsx apps/server/src/main.ts",
    "web": "pnpm --filter @forkfall/web dev",
    "mcp": "tsx apps/mcp/src/main.ts",
    "bot": "tsx packages/sdk/scripts/agent-bot.ts",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "web:build": "pnpm --filter @forkfall/web build"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
